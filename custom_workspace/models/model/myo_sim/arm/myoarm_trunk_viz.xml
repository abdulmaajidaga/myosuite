<mujoco model="MyoArm_trunk_viz">

    <include file="assets/myoarm_assets.xml"/>
    <compiler meshdir=".." texturedir=".."/>

    <asset>
        <mesh file="../myo_sim/meshes/torso_norightarm.stl" name="torso_body"/>
        <texture name="bg" type="skybox" builtin="gradient" rgb1=".9 .9 .9" rgb2=".7 .75 .8" width="512" height="512"/>
    </asset>

    <visual>
        <headlight ambient=".6 .6 .6" diffuse=".7 .7 .7" specular=".2 .2 .2"/>
        <global elevation="-10" fovy="45" offwidth="800" offheight="1000"/>
        <scale light=".05"/>
        <!-- hide muscle/actuator coloring -->
        <rgba actuator="0 0 0 0" actuatorpositive="0 0 0 0" actuatornegative="0 0 0 0"/>
    </visual>

    <worldbody>
        <light directional="true" diffuse=".7 .7 .7" specular=".2 .2 .2" pos="0 -3 5" dir="0 .5 -1"/>
        <light directional="true" diffuse=".3 .3 .3" specular="0 0 0" pos="3 -1 3" dir="-1 .3 -1"/>
        <camera name="front" pos="0 -1.8 1.3"  xyaxes="1 0 0 0 0 1" mode="trackcom"/>
        <camera name="side"  pos="2.0 0 1.3"  xyaxes="0 1 0 0 0 1" mode="trackcom"/>

        <body name="full_body" pos="-.025 0.1 1.40">
            <geom name="body_ref" type="mesh" mesh="torso_body"
                  pos="0.025 -0.1 -1.40" euler="0 0 3.14"
                  rgba=".80 .72 .62 1" contype="0" conaffinity="0"/>
            <joint name="trunk_lateral_lean" type="hinge" axis="-1 0 0" range="-0.35 0.35"/>
            <joint name="trunk_forward_lean" type="hinge" axis="0 -1 0" range="-0.35 0.35"/>
            <include file="assets/myoarm_body.xml"/>
        </body>
    </worldbody>

</mujoco>
